# Copia a .env (nunca lo subas al repositorio) y ajusta.
PORT=3000
# Local: Postgres embebido (PGlite) en esta carpeta. Producción (Vercel): cadena de conexión de Neon (obligatoria).
DB_PATH=./data/pglite
DATABASE_URL=

# Claves de acceso por rol. En producción OWNER_TOKEN es obligatorio (mín. 12 caracteres).
#   owner  = todo, incluidos pagos, bandeja "Por confirmar", importar/exportar
#   editor = crea/edita actividades (no ve pagos)
#   viewer = solo lectura de actividades
OWNER_TOKEN=
EDITOR_TOKEN=
VIEWER_TOKEN=
# Firma de sesiones. Obligatorio en producción (≥ 16 caracteres). En desarrollo, si se omite, se genera al arrancar.
SESSION_SECRET=

# GitHub (opcional). El token vive solo en el servidor.
# Fine-grained PAT limitado a los repos: Issues (read/write), Pull requests (read).
GITHUB_TOKEN=
GITHUB_REPOS=Angel172002/pruebas

