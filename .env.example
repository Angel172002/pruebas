# Copia a .env (nunca lo subas al repositorio) y ajusta.
PORT=3000
# Local: Postgres embebido (PGlite) en esta carpeta. Producción (Vercel): cadena de conexión de Neon (obligatoria).
DB_PATH=./data/pglite
DATABASE_URL=

# Primer administrador (se crea al arrancar si no hay ninguno). En producción ambos son obligatorios.
# OWNER_TOKEN es su clave INICIAL (mín. 12): el sistema le exige cambiarla en el primer ingreso.
# El resto del equipo se crea desde la pestaña "Usuarios" (un correo y una dirección por persona).
ADMIN_EMAIL=
OWNER_TOKEN=
# Recuperar al admin que perdió su clave: true + un OWNER_TOKEN NUEVO → restablece su clave a ese valor (una vez por valor). Quítalo después.
ADMIN_RECOVERY=
# Firma de sesiones. Obligatorio en producción (≥ 16 caracteres). En desarrollo, si se omite, se genera al arrancar.
SESSION_SECRET=

# GitHub (opcional). El token vive solo en el servidor.
# Fine-grained PAT limitado a los repos: Issues (read/write), Pull requests (read).
GITHUB_TOKEN=
GITHUB_REPOS=Angel172002/pruebas

# Solo desarrollo local: 1 = entrar como administrador sin login (se ignora en producción).
DEV_OPEN=
